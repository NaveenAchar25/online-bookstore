<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.bookstore</groupId>
    <artifactId>bookstore-backend</artifactId>
    <version>0.1.0</version>
    <name>bookstore-backend</name>
    <description>Online Bookstore REST API</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Core web + REST -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          Production health/readiness endpoint via Spring Boot Actuator, rather
          than a hand-rolled /health controller. This is the standard a real
          deployment (load balancer health checks, k8s liveness probes) expects.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- JPA / persistence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Bean validation (jakarta.validation) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          Flyway: versioned schema migrations from day one, even before any
          table exists — Hibernate never generates or alters schema in any
          environment. No flyway-database-h2 module: H2 (and SQLite) remain
          bundled inside flyway-core, unlike most other databases.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!--
          MySQL support WAS split out of flyway-core in the Flyway 10 module
          split, so this is required for the prod profile's migrations to run
          at all once a production database is introduced. No explicit
          version here — confirmed Spring Boot 4.1.1 already manages it
          (Maven's "overriding managed version" notice on an earlier attempt
          proved this), unlike flyway-database-h2, which isn't managed
          because it isn't a real artifact H2 needs at all.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- H2 for local/dev database -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- MySQL driver for the prod profile -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok: reduces boilerplate (getters/setters/constructors/builders) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testing: JUnit 5, Mockito, MockMvc, AssertJ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          RestTestClient: Spring Boot 4's modern replacement for
          TestRestTemplate, which Spring itself flags as soon-to-be-deprecated
          and which is no longer auto-configured by spring-boot-starter-test
          alone. This is a genuinely separate module from the similarly-named
          spring-boot-starter-restclient-test (which is for a different
          feature entirely — @RestClientTest, for testing code that calls
          OUT to other services — and does not provide RestTestClient at all).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          RestTestClient makes a real outbound HTTP call when the test runs
          against a live server (webEnvironment = RANDOM_PORT, our case) —
          spring-boot-resttestclient alone does not transitively pull in the
          underlying REST client that performs that call.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
