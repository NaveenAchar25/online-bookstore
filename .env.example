# Copy this file to .env (same folder) and fill in real values.
# .env itself is gitignored.
# This file (.env.example) is the one that gets committed, precisely because it has no real secrets.

# --- MySQL (local docker-compose only, see docker-compose.yml's own comment) ---
MYSQL_ROOT_PASSWORD=changeme-root-password
MYSQL_DATABASE=bookstore
MYSQL_USER=bookstore_user
MYSQL_PASSWORD=changeme-app-password

# --- Backend ---
# Generate a real random value — never reuse the dev-only default baked
# into application.yml. One way, from a terminal with PowerShell available:
#   powershell -Command "[System.Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))"
JWT_SECRET=replace-with-a-real-random-value

# Must match wherever the frontend is actually served from — the backend
# rejects cross-origin requests from any origin not listed here.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
